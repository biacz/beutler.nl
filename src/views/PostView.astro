---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import AuthorshipBadge from '../components/AuthorshipBadge.astro';
import Comments from '../components/Comments.astro';
import { OUTDATED_AFTER_YEARS } from '../consts';
import { formatDate, localize, t, tagLabel, type Lang } from '../i18n';
import { postSlug, postUrl, readingTime, tagSlug, type Post } from '../lib/posts';
import { postLd } from '../lib/seo';

interface Props {
  lang: Lang;
  post: Post;
  newer?: Post;
  older?: Post;
  /** The same post in the other language, if it exists. */
  other?: Post;
}
const { lang, post, newer, older, other } = Astro.props;
const ui = t(lang);
const { Content, headings } = await render(post);
const { title, description, pubDate, updatedDate, tags, cover, coverAlt, authorship, legacyUrl, translation } =
  post.data;
const restored = authorship === 'human' && (Boolean(legacyUrl) || pubDate.getFullYear() < 2026);

const toc = headings.filter((h) => h.depth === 2);
const lastTouched = updatedDate ?? pubDate;
const ageYears = (Date.now() - lastTouched.valueOf()) / (365.25 * 24 * 3600 * 1000);
const outdated = ageYears >= OUTDATED_AFTER_YEARS;

const otherLang: Lang = lang === 'de' ? 'en' : 'de';
const alternates = {
  [lang]: postUrl(post),
  [otherLang]: other ? postUrl(other) : localize('/blog/', otherLang),
} as Record<Lang, string>;
const ogImage = `/og/${post.id}.png`;
---

<Base
  lang={lang}
  title={title}
  description={description}
  type="article"
  publishedTime={pubDate}
  alternates={alternates}
  image={ogImage}
  jsonLd={postLd(post, Astro.site!, ogImage)}
>
  <article class="narrow post" data-pagefind-body>
    <header class="page-head">
      {
        tags.length > 0 && (
          <ul class="tags" data-pagefind-ignore>
            {tags.map((tag) => (
              <li>
                <a class="tag" href={localize(`/tags/${tagSlug(tag)}/`, lang)} data-pagefind-filter="tag">
                  {tagLabel(tag, lang)}
                </a>
              </li>
            ))}
          </ul>
        )
      }
      <h1>{title}</h1>
      <p class="meta" data-pagefind-ignore>
        <time datetime={pubDate.toISOString()} data-pagefind-meta="date">{formatDate(pubDate, lang)}</time>
        {
          updatedDate && (
            <>
              {` · ${ui.post.updated} `}
              <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate, lang)}</time>
            </>
          )
        }
        {' · '}
        {ui.minRead(readingTime(post.body))}{' '}
        <AuthorshipBadge authorship={authorship} lang={lang} />
        {
          translation && (
            <>
              {' '}
              <AuthorshipBadge authorship="translated" lang={lang} />
            </>
          )
        }
      </p>
    </header>

    <aside class:list={['note', { ai: authorship !== 'human' }]} role="note" data-pagefind-ignore>
      {
        restored ? (
          <p>
            <strong>{ui.post.restoredStrong(pubDate.getFullYear())}</strong> {ui.post.restored(pubDate.getFullYear())}
            {outdated && ui.post.outdated}
          </p>
        ) : (
          <p>
            <strong>{ui.authorship[authorship].long}</strong>
            {translation && ui.post.translatedNote} <a href={localize('/ai/', lang)}>{ui.post.howMade}</a>
          </p>
        )
      }
    </aside>

    {cover && <Image class="cover" src={cover} alt={coverAlt ?? ''} widths={[720, 1440]} sizes="(min-width: 50rem) 720px, 100vw" />}

    {
      toc.length >= 3 && (
        <details class="toc" data-pagefind-ignore>
          <summary>{ui.post.contents}</summary>
          <ol>
            {toc.map((h) => (
              <li>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ol>
        </details>
      )
    }

    <div class="prose" data-copy={ui.post.copy} data-copied={ui.post.copied} data-failed={ui.post.failed}>
      <Content />
    </div>

    <Comments slug={postSlug(post)} lang={lang} />
    <nav class="pager" aria-label={ui.post.more} data-pagefind-ignore>
      {
        older ? (
          <a class="prev" href={postUrl(older)}>
            <span class="meta">{ui.post.older}</span>
            {older.data.title}
          </a>
        ) : (
          <span />
        )
      }
      {
        newer && (
          <a class="next" href={postUrl(newer)}>
            <span class="meta">{ui.post.newer}</span>
            {newer.data.title}
          </a>
        )
      }
    </nav>
  </article>
</Base>

<script>
  // Copy buttons for code blocks; labels come from data attributes (language-specific).
  const prose = document.querySelector<HTMLElement>('.prose[data-copy]');
  const L = { copy: prose?.dataset.copy ?? 'Copy', copied: prose?.dataset.copied ?? 'Copied ✓', failed: prose?.dataset.failed ?? 'Failed' };
  for (const pre of document.querySelectorAll<HTMLPreElement>('.prose pre.astro-code')) {
    const wrap = document.createElement('div');
    wrap.className = 'code-block';
    pre.replaceWith(wrap);
    wrap.append(pre);
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'copy-btn';
    btn.textContent = L.copy;
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(pre.innerText);
        btn.textContent = L.copied;
      } catch {
        btn.textContent = L.failed;
      }
      setTimeout(() => (btn.textContent = L.copy), 1600);
    });
    wrap.append(btn);
  }
</script>

<style>
  .post .tags {
    margin-bottom: 0.9rem;
  }
  .post .page-head h1 {
    font-size: clamp(1.9rem, 1.4rem + 2.2vw, 2.8rem);
  }
  .post .meta {
    margin-top: 0.75rem;
  }
  .note.ai {
    border-left-color: var(--link);
  }
  .note {
    margin-bottom: 2rem;
    padding: 0.8rem 1rem;
    border-left: 3px solid var(--accent);
    border-radius: 0 var(--radius) var(--radius) 0;
    background: var(--surface-2);
    font-size: 0.92rem;
  }
  .cover {
    margin-bottom: 2rem;
    border-radius: var(--radius);
  }
  .toc {
    margin-bottom: 2rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .toc summary {
    font-weight: 600;
    cursor: pointer;
  }
  .toc ol {
    margin-top: 0.5rem;
    padding-left: 1.25rem;
  }
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }
  .pager a {
    display: grid;
    gap: 0.2rem;
    padding: 0.9rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
    font-weight: 600;
    text-decoration: none;
  }
  .pager a:hover {
    border-color: var(--link);
  }
  .pager .next {
    text-align: right;
  }
  @media (max-width: 36rem) {
    .pager {
      grid-template-columns: 1fr;
    }
  }
</style>
