---
import Base from '../layouts/Base.astro';
import { localize, t, tagLabel, type Lang } from '../i18n';
import { getPosts, groupByTag } from '../lib/posts';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const ui = t(lang).tags;
const tags = groupByTag(await getPosts(lang));
---

<Base lang={lang} title={ui.title} description={ui.description}>
  <div class="narrow">
    <header class="page-head">
      <h1>{ui.title}</h1>
      <p>{ui.intro(tags.length)}</p>
    </header>
    <ul class="tags big">
      {
        tags.map(([slug, { name, posts }]) => (
          <li>
            <a class="tag" href={localize(`/tags/${slug}/`, lang)}>
              {tagLabel(name, lang)} <span class="count">{posts.length}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Base>

<style>
  .big {
    gap: 0.6rem;
  }
  .big .tag {
    padding: 0.35rem 0.9rem;
    font-size: 0.95rem;
  }
  .count {
    margin-left: 0.2rem;
    opacity: 0.7;
  }
</style>
