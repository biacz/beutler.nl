---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { localize, t, tagLabel, type Lang } from '../i18n';
import { getPosts, groupByTag } from '../lib/posts';
import { personLd } from '../lib/seo';
import banner from '../assets/banner.jpg';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const ui = t(lang);
const posts = await getPosts(lang);
const topTags = groupByTag(posts).slice(0, 10);
const home = new URL(localize('/', lang), Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'beutler.nl',
  url: home,
  inLanguage: lang,
  description: ui.description,
  author: personLd(Astro.site!),
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `${new URL(localize('/search/', lang), Astro.site)}?q={search_term_string}`,
    },
    'query-input': 'required name=search_term_string',
  },
};
---

<Base lang={lang} jsonLd={jsonLd}>
  <div class="banner">
    <Image
      src={banner}
      alt=""
      widths={[640, 1024, 1920]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
  </div>

  <section class="container intro">
    <p class="eyebrow">{ui.tagline}</p>
    <h1>{ui.home.hi}</h1>
    <p class="lead">{ui.home.lead}</p>
    <p class="ai-note">
      <span class="spark" aria-hidden="true">✦</span>
      <span>
        <strong>{ui.home.aiNoteStrong}</strong> {ui.home.aiNote} <a href={localize('/ai/', lang)}>{ui.home.aiNoteLink}</a>
      </span>
    </p>
  </section>

  <div class="container layout">
    <section aria-labelledby="latest">
      <h2 id="latest" class="section-title">{ui.home.latest}</h2>
      <PostList posts={posts.slice(0, 8)} lang={lang} headingLevel={3} />
      <p class="more"><a href={localize('/blog/', lang)}>{ui.home.allPosts(posts.length)}</a></p>
    </section>

    <aside aria-labelledby="topics">
      <h2 id="topics" class="section-title">{ui.topics}</h2>
      <ul class="tags">
        {
          topTags.map(([slug, { name, posts }]) => (
            <li>
              <a class="tag" href={localize(`/tags/${slug}/`, lang)}>
                {tagLabel(name, lang)} <span class="count">{posts.length}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="more"><a href={localize('/tags/', lang)}>{ui.home.allTopics}</a></p>
    </aside>
  </div>
</Base>

<style>
  /* The old site's pixel-art desk banner, kept as a full-width strip under the header. */
  .banner {
    aspect-ratio: 1920 / 400;
    max-height: 18rem;
    width: 100%;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
  }
  .banner img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  :global(:root[data-theme='dark']) .banner img {
    filter: brightness(0.8) contrast(1.05);
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .banner img {
      filter: brightness(0.8) contrast(1.05);
    }
  }
  .intro {
    padding-block: clamp(2rem, 5vw, 3.5rem) clamp(1.5rem, 4vw, 2.5rem);
    max-width: var(--wide);
  }
  .intro h1 {
    margin-top: 0.4rem;
    font-size: clamp(2.2rem, 1.6rem + 3vw, 3.6rem);
  }
  .lead {
    max-width: 60ch;
    margin-top: 0.8rem;
    color: var(--muted);
    font-size: 1.1em;
  }
  .ai-note {
    display: flex;
    gap: 0.6rem;
    max-width: 60ch;
    margin-top: 1.25rem;
    padding: 0.75rem 1rem;
    border: 1px solid color-mix(in oklab, var(--link) 40%, var(--border));
    border-radius: var(--radius);
    background: color-mix(in oklab, var(--link) 8%, transparent);
    font-size: 0.95rem;
  }
  .spark {
    color: var(--link);
  }
  .layout {
    display: grid;
    gap: 3rem;
  }
  @media (min-width: 60rem) {
    .layout {
      grid-template-columns: minmax(0, 1fr) 16rem;
    }
    aside {
      position: sticky;
      top: 5rem;
      align-self: start;
    }
  }
  .section-title {
    margin-bottom: 0.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--accent);
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    width: fit-content;
  }
  aside .tags {
    margin-top: 1rem;
  }
  .count {
    margin-left: 0.15rem;
    font-weight: 600;
  }
  .more {
    margin-top: 1rem;
    font-weight: 600;
  }
</style>
