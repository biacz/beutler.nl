---
// Every change to the site, from git history: what the AI changed, what Niko changed, what bots changed.
import Base from '../layouts/Base.astro';
import { SITE } from '../consts';
import { formatDate, formatMonth, localize, t, type Lang } from '../i18n';
import { getChanges, type ChangeKind } from '../lib/changelog';
import { getPosts, postSlug } from '../lib/posts';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const changes = getChanges();
const published = new Map((await getPosts(lang)).map((p) => [postSlug(p), p.data.title]));
const aiCount = changes.filter((c) => c.kind === 'ai').length;
const first = changes.at(-1)?.date;
const months = Map.groupBy(changes, (c) => formatMonth(c.date, lang));

const T = {
  en: {
    title: 'Changelog',
    description: 'Every change to beutler.nl, generated from the git history – including which changes were made by AI.',
    eyebrow: 'Transparency',
    intro: 'Every change to this site is a git commit. This list is generated from the git history on every build, so it is always complete.',
    stats: (ai: number, all: number) =>
      `${ai} of ${all} changes${first ? ` since ${formatDate(first, lang)}` : ''} were made by AI (Claude) – Niko reviews them before they go live.`,
    kinds: { ai: 'AI', human: 'Niko', bot: 'Bot' } satisfies Record<ChangeKind, string>,
    kindTitle: {
      ai: 'Co-authored by Claude (AI)',
      human: 'Made by Niko without AI',
      bot: 'Automated (e.g. dependency updates)',
    } satisfies Record<ChangeKind, string>,
    posts: 'Posts:',
    files: (n: number) => `${n} ${n === 1 ? 'file' : 'files'}`,
    empty: 'The history is not available in this build.',
    all: 'Full history on GitHub →',
    note: '',
  },
  de: {
    title: 'Änderungen',
    description: 'Jede Änderung an beutler.nl, erzeugt aus der Git-Historie – inklusive welche Änderungen von KI stammen.',
    eyebrow: 'Transparenz',
    intro: 'Jede Änderung an dieser Seite ist ein Git-Commit. Diese Liste entsteht bei jedem Build aus der Git-Historie und ist deshalb immer vollständig.',
    stats: (ai: number, all: number) =>
      `${ai} von ${all} Änderungen${first ? ` seit dem ${formatDate(first, lang)}` : ''} stammen von KI (Claude) – Niko prüft sie, bevor sie live gehen.`,
    kinds: { ai: 'KI', human: 'Niko', bot: 'Bot' } satisfies Record<ChangeKind, string>,
    kindTitle: {
      ai: 'Mit Claude (KI) als Co-Autor',
      human: 'Von Niko ohne KI',
      bot: 'Automatisch (z. B. Updates von Abhängigkeiten)',
    } satisfies Record<ChangeKind, string>,
    posts: 'Beiträge:',
    files: (n: number) => `${n} ${n === 1 ? 'Datei' : 'Dateien'}`,
    empty: 'Die Historie ist in diesem Build nicht verfügbar.',
    all: 'Komplette Historie auf GitHub →',
    note: 'Die Commit-Texte sind auf Englisch.',
  },
}[lang];
---

<Base lang={lang} title={T.title} description={T.description}>
  <div class="narrow">
    <header class="page-head">
      <p class="eyebrow">{T.eyebrow}</p>
      <h1>{T.title}</h1>
      <p>{T.intro} {T.note}</p>
      {changes.length > 0 && <p class="stats">{T.stats(aiCount, changes.length)}</p>}
    </header>
    {changes.length === 0 && <p class="meta">{T.empty}</p>}
    {
      [...months].map(([month, list]) => (
        <section class="month" aria-label={month}>
          <h2>{month}</h2>
          <ol>
            {list.map((c) => (
              <li class="change">
                <span class:list={['kind', c.kind]} title={T.kindTitle[c.kind]}>
                  {T.kinds[c.kind]}
                </span>
                <div>
                  <a class="subject" href={`${SITE.repo}/commit/${c.sha}`}>
                    {c.subject}
                  </a>
                  <p class="meta">
                    <time datetime={c.date.toISOString()}>{formatDate(c.date, lang)}</time>
                    {' · '}
                    <code>{c.sha.slice(0, 7)}</code>
                    {' · '}
                    {T.files(c.files)}
                    {c.posts.some((s) => published.has(s)) && (
                      <>
                        {' · '}
                        {T.posts}{' '}
                        {c.posts
                          .filter((s) => published.has(s))
                          .slice(0, 5)
                          // One line on purpose: line breaks here would become spaces before the commas.
                          .map((s, i) => <>{i > 0 && ', '}<a href={localize(`/blog/${s}/`, lang)}>{published.get(s)}</a></>)}
                        {c.posts.filter((s) => published.has(s)).length > 5 && ' …'}
                      </>
                    )}
                  </p>
                </div>
              </li>
            ))}
          </ol>
        </section>
      ))
    }
    <p class="all"><a href={`${SITE.repo}/commits/main/`}>{T.all}</a></p>
  </div>
</Base>

<style>
  .stats {
    margin-top: 1rem;
    padding: 0.75rem 1rem;
    border-left: 3px solid var(--link);
    background: color-mix(in oklab, var(--link) 8%, transparent);
    color: var(--text);
  }
  .month + .month {
    margin-top: 2rem;
  }
  .month h2 {
    color: var(--accent);
    font-size: 1.1rem;
  }
  ol {
    display: grid;
    gap: 0.9rem;
    margin-top: 0.75rem;
    padding: 0;
    list-style: none;
  }
  .change {
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    gap: 0.75rem;
    align-items: start;
  }
  .kind {
    padding: 0.05rem 0;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.75rem;
    font-weight: 700;
    text-align: center;
  }
  .kind.ai {
    border-color: color-mix(in oklab, var(--link) 45%, transparent);
    background: color-mix(in oklab, var(--link) 10%, transparent);
    color: var(--link);
  }
  .subject {
    color: var(--text);
    font-weight: 600;
    text-decoration: none;
  }
  .subject:hover {
    text-decoration: underline;
  }
  .meta code {
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: 0.9em;
  }
  .all {
    margin-top: 2rem;
  }
</style>
