---
import Base from '../../layouts/Base.astro';
import { getPosts, groupByTag } from '../../lib/posts';

const tags = groupByTag(await getPosts());
---

<Base title="Topics" description="All topics on beutler.nl.">
  <div class="narrow">
    <header class="page-head">
      <h1>Topics</h1>
      <p>{tags.length} topics, most-used first.</p>
    </header>
    <ul class="tags big">
      {
        tags.map(([slug, { name, posts }]) => (
          <li>
            <a class="tag" href={`/tags/${slug}/`}>
              {name} <span class="count">{posts.length}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Base>

<style>
  .big {
    gap: 0.6rem;
  }
  .big .tag {
    padding: 0.35rem 0.9rem;
    font-size: 0.95rem;
  }
  .count {
    margin-left: 0.2rem;
    opacity: 0.7;
  }
</style>
