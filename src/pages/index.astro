---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { SITE } from '../consts';
import { getPosts, groupByTag } from '../lib/posts';
import banner from '../assets/banner.jpg';

const posts = await getPosts();
const topTags = groupByTag(posts).slice(0, 10);
---

<Base>
  <div class="banner">
    <Image
      src={banner}
      alt=""
      widths={[640, 1024, 1920]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
  </div>

  <section class="container intro">
    <p class="eyebrow">{SITE.tagline}</p>
    <h1>Hi, I’m Niko.</h1>
    <p class="lead">
      I write down what I figure out along the way: PowerShell and PowerCLI scripts, VMware, Azure, Linux servers,
      and whatever else I’m tinkering with. Some of it dates back to 2014 – it’s all still here.
    </p>
  </section>

  <div class="container layout">
    <section aria-labelledby="latest">
      <h2 id="latest" class="section-title">Latest posts</h2>
      <PostList posts={posts.slice(0, 8)} headingLevel={3} />
      <p class="more"><a href="/blog/">All {posts.length} posts →</a></p>
    </section>

    <aside aria-labelledby="topics">
      <h2 id="topics" class="section-title">Topics</h2>
      <ul class="tags">
        {
          topTags.map(([slug, { name, posts }]) => (
            <li>
              <a class="tag" href={`/tags/${slug}/`}>
                {name} <span class="count">{posts.length}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="more"><a href="/tags/">All topics →</a></p>
    </aside>
  </div>
</Base>

<style>
  /* The old site's pixel-art desk banner, kept as a full-width strip under the header. */
  .banner {
    aspect-ratio: 1920 / 400;
    max-height: 18rem;
    width: 100%;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
  }
  .banner img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  :global(:root[data-theme='dark']) .banner img {
    filter: brightness(0.8) contrast(1.05);
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .banner img {
      filter: brightness(0.8) contrast(1.05);
    }
  }
  .intro {
    padding-block: clamp(2rem, 5vw, 3.5rem) clamp(1.5rem, 4vw, 2.5rem);
    max-width: var(--wide);
  }
  .intro h1 {
    margin-top: 0.4rem;
    font-size: clamp(2.2rem, 1.6rem + 3vw, 3.6rem);
  }
  .lead {
    max-width: 60ch;
    margin-top: 0.8rem;
    color: var(--muted);
    font-size: 1.1em;
  }
  .layout {
    display: grid;
    gap: 3rem;
  }
  @media (min-width: 60rem) {
    .layout {
      grid-template-columns: minmax(0, 1fr) 16rem;
    }
    aside {
      position: sticky;
      top: 5rem;
      align-self: start;
    }
  }
  .section-title {
    margin-bottom: 0.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--accent);
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    width: fit-content;
  }
  aside .tags {
    margin-top: 1rem;
  }
  .count {
    margin-left: 0.15rem;
    opacity: 0.7;
  }
  .more {
    margin-top: 1rem;
    font-weight: 600;
  }
</style>
