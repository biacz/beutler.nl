---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import AuthorshipBadge from '../components/AuthorshipBadge.astro';
import { AI, AUTHORSHIP, SITE } from '../consts';
import { getPosts } from '../lib/posts';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const rendered = await Promise.all(projects.map(async (p) => ({ p, Content: (await render(p)).Content })));

const posts = await getPosts();
const counts = Object.fromEntries(
  (Object.keys(AUTHORSHIP) as (keyof typeof AUTHORSHIP)[]).map((k) => [k, posts.filter((p) => p.data.authorship === k).length]),
);
const monthYear = new Intl.DateTimeFormat(SITE.locale, { month: 'long', year: 'numeric' });
---

<Base
  title="AI"
  description="This site is built and maintained by AI (Claude) together with Niko. What the AI does, what Niko does, how posts are labeled, and Niko’s AI projects."
>
  <div class="narrow">
    <header class="page-head">
      <p class="eyebrow">Transparency</p>
      <h1>This site is maintained by AI.</h1>
      <p class="lead">
        Since {AI.since}, beutler.nl is built, run and largely written by {AI.name}, an AI by {AI.maker}, working
        together with me. That’s a deliberate choice, not something to hide – this blog is also where I show what I build
        with AI.
      </p>
    </header>

    <div class="prose">
      <h2>Who does what</h2>
      <div class="split">
        <section class="card ai">
          <h3>The AI ({AI.name})</h3>
          <ul>
            <li>writes and maintains all code, design and the deployment</li>
            <li>drafts posts from my notes, ideas and experiments</li>
            <li>restored the 2014–2022 posts from the Internet Archive</li>
            <li>keeps dependencies and docs up to date</li>
          </ul>
        </section>
        <section class="card">
          <h3>Me (Niko)</h3>
          <ul>
            <li>decides what to build and what to write about</li>
            <li>reviews every post and change before it goes live</li>
            <li>is responsible for everything published here</li>
            <li>still writes some posts myself – they’re labeled</li>
          </ul>
        </section>
      </div>

      <h2>How posts are labeled</h2>
      <p>Every post says who wrote it, right under the title:</p>
      <ul class="labels">
        {
          (Object.keys(AUTHORSHIP) as (keyof typeof AUTHORSHIP)[]).map((k) => (
            <li>
              <AuthorshipBadge authorship={k} /> {AUTHORSHIP[k].long}{' '}
              <span class="meta">({counts[k]} {counts[k] === 1 ? 'post' : 'posts'})</span>
            </li>
          ))
        }
      </ul>
      <p>
        The label is a required field in the code: a post without it doesn’t build. The 34 posts from 2014–2022 are my
        own writing from back then; the AI only restored them.
      </p>

      <h2>The setup</h2>
      <ul>
        <li><strong>AI:</strong> {AI.model} in {AI.tool}, running on my PC with access to this site’s repository.</li>
        <li>
          <strong>Site:</strong> <a href="https://astro.build">Astro</a>, posts as Markdown files, hosted on GitHub Pages.
          Every change is a git commit – the AI’s commits are marked as co-authored by {AI.name}.
        </li>
        <li>
          <strong>Rules for the AI</strong> live in the repository (<a href={`${SITE.repo}/blob/main/AGENTS.md`}
            >AGENTS.md</a
          >): nothing goes live without my OK, no tracking, every post labeled.
        </li>
        <li>
          <strong>Everything is public:</strong> <a href={SITE.repo}>source code and full history on GitHub</a>.
        </li>
      </ul>
    </div>

    <section class="projects" aria-labelledby="projects">
      <h2 id="projects">AI projects</h2>
      <p class="meta">Things I build with AI. More to come.</p>
      <ul>
        {
          rendered.map(({ p, Content }) => (
            <li class="project">
              <div class="project-head">
                <h3>{p.data.link ? <a href={p.data.link}>{p.data.title}</a> : p.data.title}</h3>
                <span class:list={['status', p.data.status.replace(' ', '-')]}>{p.data.status}</span>
              </div>
              <p class="summary">{p.data.summary}</p>
              <div class="prose small">
                <Content />
              </div>
              <p class="meta">
                Since {monthYear.format(p.data.started)}
                {p.data.repo && (
                  <>
                    {' · '}
                    <a href={p.data.repo}>Source</a>
                  </>
                )}
                {p.data.post && (
                  <>
                    {' · '}
                    <a href={`/blog/${p.data.post}/`}>Write-up</a>
                  </>
                )}
              </p>
              {p.data.stack.length > 0 && (
                <ul class="tags">
                  {p.data.stack.map((s) => (
                    <li>
                      <span class="tag">{s}</span>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Base>

<style>
  .lead {
    font-size: 1.1em;
  }
  .split {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 40rem) {
    .split {
      grid-template-columns: 1fr 1fr;
    }
  }
  .card {
    padding: 1rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .card.ai {
    border-color: color-mix(in oklab, var(--link) 40%, var(--border));
  }
  .card h3 {
    margin-top: 0;
    font-size: 1.05em;
  }
  .card ul {
    margin-top: 0.5rem;
  }
  .labels {
    padding: 0;
    list-style: none;
  }
  .labels li + li {
    margin-top: 0.6rem;
  }
  .labels li::marker {
    content: none;
  }
  .projects {
    margin-top: 3.5rem;
  }
  .projects h2 {
    font-size: 1.6em;
  }
  .projects > ul {
    margin-top: 1.25rem;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 1rem;
  }
  .project {
    display: grid;
    gap: 0.6rem;
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .project-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .project h3 {
    font-size: 1.2rem;
  }
  .project h3 a {
    color: var(--text);
  }
  .summary {
    font-weight: 500;
  }
  .prose.small {
    color: var(--muted);
    font-size: 0.95em;
  }
  .status {
    padding: 0 0.5rem;
    border-radius: 999px;
    background: var(--surface-2);
    color: var(--muted);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .status.live {
    background: color-mix(in oklab, #2f9e44 18%, transparent);
    color: light-dark(#237032, #69db7c);
  }
</style>
