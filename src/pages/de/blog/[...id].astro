---
import PostView from '../../../views/PostView.astro';
import { getPosts, postSlug, type Post } from '../../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts('de');
  const others = new Map((await getPosts('en')).map((p) => [postSlug(p), p]));
  return posts.map((post, i) => ({
    params: { id: postSlug(post) },
    // newest first: "newer" is the previous entry, "older" the next.
    props: { post, newer: posts[i - 1], older: posts[i + 1], other: others.get(postSlug(post)) },
  }));
}

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
  other?: Post;
}
const { post, newer, older, other } = Astro.props;
---

<PostView lang="de" post={post} newer={newer} older={older} other={other} />
