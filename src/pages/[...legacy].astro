---
// Redirect pages for URLs of the old WordPress blog (2014–2022), so old links and search results keep working.
// GitHub Pages has no server-side redirects, so each one is a tiny HTML page with a meta refresh.
import { getPosts, postUrl } from '../lib/posts';

export async function getStaticPaths() {
  const OLD_TAXONOMY: Record<string, string> = {
    // old WordPress category/tag slug -> new URL
    apache: '/tags/apache/',
    automation: '/tags/automation/',
    avd: '/tags/azure-virtual-desktop/',
    azure: '/tags/azure/',
    dovecot: '/tags/mail-server/',
    dusseldorf: '/tags/duesseldorf/',
    general: '/blog/',
    linux: '/tags/linux/',
    multicopter: '/tags/fpv-drones/',
    'power-cli': '/tags/powercli/',
    powershell: '/tags/powershell/',
    storage: '/tags/storage/',
    vcenter: '/tags/vcenter/',
    view: '/tags/vmware-horizon/',
    vmware: '/tags/vmware/',
    vsphere: '/tags/vsphere/',
    webhosting: '/tags/webhosting/',
    flow: '/tags/power-automate/',
    powerapps: '/tags/power-apps/',
    powerautomate: '/tags/power-automate/',
  };

  const posts = await getPosts();
  const routes: { from: string; to: string }[] = posts
    .filter((p) => p.data.legacyUrl)
    .map((p) => ({ from: p.data.legacyUrl!, to: postUrl(p) }));

  for (const [slug, to] of Object.entries(OLD_TAXONOMY)) {
    routes.push({ from: `/category/${slug}/`, to });
    routes.push({ from: `/tag/${slug}/`, to });
  }
  routes.push({ from: '/contact/', to: '/about/' }, { from: '/page/2/', to: '/blog/' }, { from: '/page/3/', to: '/blog/' });

  // Year/month archives of the old blog -> blog index.
  const months = new Set(
    posts.flatMap((p) => (/^\/\d{4}\/\d{2}\//.test(p.data.legacyUrl ?? '') ? [p.data.legacyUrl!.slice(0, 9)] : [])),
  );
  for (const m of months) routes.push({ from: m, to: '/blog/' });

  return routes.map(({ from, to }) => ({
    params: { legacy: from.replace(/^\/|\/$/g, '') },
    props: { to },
  }));
}

const { to } = Astro.props;
const target = new URL(to, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Moved</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={target} />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
  </head>
  <body>
    <p>This page has moved to <a href={to}>{target}</a>.</p>
  </body>
</html>
