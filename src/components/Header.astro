---
import { NAV } from '../consts';
import { LANGS, localize, t, unlocalize, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  alternates: Record<Lang, string>;
}
const { lang, alternates } = Astro.props;
const ui = t(lang);
const path = unlocalize(Astro.url.pathname);
const isActive = (href: string) => path === href || path.startsWith(href);
---

<header class="site-header">
  <div class="container bar">
    <a class="wordmark" href={localize('/', lang)} aria-label={`beutler.nl – ${ui.homeLabel}`}>
      beutler<span class="dot">.</span><span class="tld">nl</span>
    </a>
    <nav aria-label={lang === 'de' ? 'Hauptmenü' : 'Main'}>
      <ul>
        {
          NAV.map((item) => (
            <li class={`nav-${item.key}`}>
              <a href={localize(item.href, lang)} aria-current={isActive(item.href) ? 'page' : undefined}>
                {ui.nav[item.key]}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a
      class="icon-btn"
      href={localize('/search/', lang)}
      aria-label={ui.search.label}
      title={ui.search.label}
      aria-current={isActive('/search/') ? 'page' : undefined}
    >
      <svg viewBox="0 0 24 24" width="19" height="19" aria-hidden="true">
        <circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2.2"></circle>
        <path d="M15.5 15.5 21 21" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"></path>
      </svg>
    </a>
    <ul class="langs" aria-label={ui.language}>
      {
        LANGS.map((l) => (
          <li>
            <a
              href={alternates[l]}
              hreflang={l}
              lang={l}
              aria-current={l === lang ? 'true' : undefined}
              title={l === 'de' ? 'Deutsch' : 'English'}
            >
              {l.toUpperCase()}
            </a>
          </li>
        ))
      }
    </ul>
    <button class="theme-toggle" type="button" aria-label={ui.toggleTheme} title={ui.toggleTheme}>
      <svg class="sun" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
        <circle cx="12" cy="12" r="4.5" fill="currentColor"></circle>
        <g stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M12 1.5v2.5M12 20v2.5M1.5 12H4M20 12h2.5M4.6 4.6l1.8 1.8M17.6 17.6l1.8 1.8M4.6 19.4l1.8-1.8M17.6 6.4l1.8-1.8"></path>
        </g>
      </svg>
      <svg class="moon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
        <path fill="currentColor" d="M20.5 14.6A8.5 8.5 0 0 1 9.4 3.5a8.5 8.5 0 1 0 11.1 11.1Z"></path>
      </svg>
    </button>
  </div>
</header>

<script>
  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>('.theme-toggle')!;
  const isDark = () =>
    root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
  const sync = () => button.setAttribute('aria-pressed', String(isDark()));
  sync();
  button.addEventListener('click', () => {
    const next = isDark() ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
    sync();
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--header-bg);
    color: #fff;
    view-transition-name: site-header;
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 3.5rem;
  }
  .wordmark {
    margin-right: auto;
    color: #fff;
    font-family: var(--font-heading), system-ui, sans-serif;
    font-size: 1.35rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    text-decoration: none;
  }
  .dot {
    color: #e0544a;
  }
  .tld {
    color: #8db4ec;
  }
  ul {
    display: flex;
    gap: 0.25rem;
    padding: 0;
    list-style: none;
  }
  nav a {
    display: block;
    white-space: nowrap;
    padding: 1rem 0.6rem;
    color: #e5e5e5;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    box-shadow: inset 0 -3px 0 transparent;
    transition: box-shadow 0.15s, color 0.15s;
  }
  nav a:hover {
    color: #fff;
    box-shadow: inset 0 -3px 0 rgb(255 255 255 / 0.35);
  }
  /* The old site marked the active page red – kept as an accent bar. */
  nav a[aria-current='page'] {
    color: #fff;
    box-shadow: inset 0 -3px 0 #e0544a;
  }
  .langs {
    display: flex;
    gap: 0;
    border: 1px solid rgb(255 255 255 / 0.25);
    border-radius: 999px;
    overflow: hidden;
  }
  .langs a {
    display: block;
    padding: 0.2rem 0.5rem;
    color: #c9cacd;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-decoration: none;
    box-shadow: none;
  }
  .langs a:hover {
    color: #fff;
    background: rgb(255 255 255 / 0.1);
  }
  .langs a[aria-current] {
    color: #fff;
    background: rgb(255 255 255 / 0.18);
  }
  .theme-toggle,
  .icon-btn {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid rgb(255 255 255 / 0.25);
    border-radius: 999px;
    background: transparent;
    color: #fff;
    cursor: pointer;
  }
  .icon-btn[aria-current] {
    border-color: #e0544a;
  }
  .theme-toggle:hover,
  .icon-btn:hover {
    background: rgb(255 255 255 / 0.1);
  }
  .theme-toggle .moon {
    display: none;
  }
  :global(:root[data-theme='dark']) .theme-toggle .sun {
    display: none;
  }
  :global(:root[data-theme='dark']) .theme-toggle .moon {
    display: block;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .theme-toggle .sun {
      display: none;
    }
    :global(:root:not([data-theme='light'])) .theme-toggle .moon {
      display: block;
    }
  }
  @media (max-width: 30rem) {
    .bar {
      gap: 0.4rem;
    }
    .wordmark {
      font-size: 1.1rem;
    }
    ul {
      gap: 0;
    }
    nav a {
      padding-inline: 0.35rem;
      font-size: 0.875rem;
    }
    .theme-toggle,
    .icon-btn {
      width: 2rem;
      height: 2rem;
    }
    /* On phones only the other language is shown, to save room. */
    .langs a[aria-current] {
      display: none;
    }
  }
  /* Very small phones: Topics leaves the header (still linked from the home page and every post). */
  @media (max-width: 25rem) {
    .nav-topics {
      display: none;
    }
  }
  @media (max-width: 22.5rem) {
    .bar {
      gap: 0.2rem;
    }
    .langs a {
      padding-inline: 0.35rem;
    }
    .theme-toggle,
    .icon-btn {
      width: 1.75rem;
      height: 1.75rem;
    }
    .wordmark {
      font-size: 1rem;
    }
    nav a {
      padding-inline: 0.25rem;
      font-size: 0.8rem;
    }
  }
</style>
