---
import AuthorshipBadge from './AuthorshipBadge.astro';
import { formatDate, localize, t, tagLabel, type Lang } from '../i18n';
import { postUrl, readingTime, tagSlug, type Post } from '../lib/posts';

interface Props {
  posts: Post[];
  lang: Lang;
  headingLevel?: 2 | 3;
}
const { posts, lang, headingLevel = 2 } = Astro.props;
const ui = t(lang);
const H = `h${headingLevel}`;
---

<ul class="post-list">
  {
    posts.map((post) => (
      <li>
        <article>
          <p class="meta">
            <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate, lang)}</time>
            {' · '}
            {ui.minRead(readingTime(post.body))}{' '}
            <AuthorshipBadge authorship={post.data.authorship} lang={lang} small />
            {post.data.translation && (
              <>
                {' '}
                <AuthorshipBadge authorship="translated" lang={lang} small />
              </>
            )}
            {post.data.draft && <span class="draft">{ui.draft}</span>}
          </p>
          <H class="title">
            <a href={postUrl(post)}>{post.data.title}</a>
          </H>
          <p class="desc">{post.data.description}</p>
          {post.data.tags.length > 0 && (
            <ul class="tags" aria-label={ui.topics}>
              {post.data.tags.map((tag) => (
                <li>
                  <a class="tag" href={localize(`/tags/${tagSlug(tag)}/`, lang)}>
                    {tagLabel(tag, lang)}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </article>
      </li>
    ))
  }
</ul>

<style>
  .post-list {
    padding: 0;
    list-style: none;
  }
  .post-list > li {
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--border);
  }
  .post-list > li:first-child {
    padding-top: 0.5rem;
  }
  article {
    display: grid;
    gap: 0.4rem;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.3rem 0.4rem;
  }
  .title {
    font-size: 1.3rem;
  }
  .title a {
    color: var(--text);
    text-decoration: none;
  }
  .title a:hover {
    color: var(--link);
    text-decoration: underline;
  }
  .desc {
    color: var(--muted);
  }
  .tags {
    margin-top: 0.25rem;
  }
  .draft {
    padding: 0 0.4rem;
    border-radius: 0.25rem;
    background: var(--accent);
    color: #fff;
    font-size: 0.75rem;
  }
</style>
