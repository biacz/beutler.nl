---
import { t, type Authorship, type Lang } from '../i18n';

interface Props {
  /** Who wrote the text – or 'translated' for the "AI-translated" badge. */
  authorship: Authorship | 'translated';
  lang: Lang;
  small?: boolean;
}
const { authorship, lang, small = false } = Astro.props;
const ui = t(lang);
const label = authorship === 'translated' ? ui.translated : ui.authorship[authorship];
const isAI = authorship !== 'human';
---

<span class:list={['badge', { ai: isAI, small }]} title={label.long}>
  {
    authorship === 'translated' ? (
      <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
        <path
          fill="currentColor"
          d="M12.9 15.1l-2.5-2.5v-.1a17 17 0 0 0 3.6-6.4H17V4h-7V2H8v2H1v2h11.2A15.7 15.7 0 0 1 9 11.4 15.6 15.6 0 0 1 6.7 8H4.7a17.6 17.6 0 0 0 3 4.6l-5.1 5 1.4 1.4 5-5 3.1 3.1.8-2zM18.5 10h-2L12 22h2l1.1-3h4.8l1.1 3h2l-4.5-12zm-2.6 7l1.6-4.3 1.6 4.3h-3.2z"
        />
      </svg>
    ) : isAI ? (
      <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
        <path
          fill="currentColor"
          d="M12 2l1.9 5.6L19.5 9.5l-5.6 1.9L12 17l-1.9-5.6L4.5 9.5l5.6-1.9L12 2zm6.5 11l.9 2.6 2.6.9-2.6.9-.9 2.6-.9-2.6-2.6-.9 2.6-.9.9-2.6z"
        />
      </svg>
    ) : (
      <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
        <path fill="currentColor" d="M3 17.2V21h3.8l11-11-3.8-3.8-11 11zm17.7-10.1a1 1 0 0 0 0-1.4l-2.4-2.4a1 1 0 0 0-1.4 0l-1.8 1.8 3.8 3.8 1.8-1.8z" />
      </svg>
    )
  }
  {label.short}
</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.1rem 0.55rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.8rem;
    font-weight: 600;
    line-height: 1.6;
    white-space: nowrap;
    vertical-align: middle;
  }
  .badge.ai {
    border-color: color-mix(in oklab, var(--link) 45%, transparent);
    background: color-mix(in oklab, var(--link) 10%, transparent);
    color: var(--link);
  }
  .badge.small {
    padding: 0 0.45rem;
    font-size: 0.72rem;
  }
</style>
