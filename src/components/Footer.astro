---
import { SITE } from '../consts';
import { localize, t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const ui = t(lang);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container inner">
    <div>
      <p>© 2014–{year} {SITE.author}</p>
      <p class="ai-line">
        {ui.footerAi} <a href={localize('/ai/', lang)}>{ui.howItWorks}</a>
      </p>
    </div>
    <ul>
      <li><a href={localize('/rss.xml', lang)}>RSS</a></li>
      <li><a href={SITE.github} rel="me">GitHub</a></li>
      <li><a href="/impressum/" lang="de">Impressum</a></li>
      <li><a href="/datenschutz/" lang="de">Datenschutz</a></li>
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 4rem;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.9rem;
  }
  .inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding-block: 1.75rem;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    padding: 0;
    list-style: none;
  }
  a {
    color: inherit;
  }
  .ai-line {
    margin-top: 0.25rem;
  }
  .ai-line a {
    color: var(--link);
  }
  a:hover {
    color: var(--accent);
  }
</style>
